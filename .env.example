# Examples only. The application does NOT automatically read .env files.
# Set variables in PowerShell (see README). Never commit real keys.
SOUNDSKETCH_DATA_DIR=./data
# compatible (manual model/base URL), mimo, or deepseek.
# mimo defaults: https://api.xiaomimimo.com/v1 + mimo-v2.6-flash
# deepseek defaults: https://api.deepseek.com + deepseek-flash
SOUNDSKETCH_PLANNER_PROVIDER=compatible
SOUNDSKETCH_PLANNER_API_KEY=
SOUNDSKETCH_PLANNER_BASE_URL=https://api.openai.com/v1
SOUNDSKETCH_PLANNER_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
